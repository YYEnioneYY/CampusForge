generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  USER      @map("user")
  MODERATOR @map("moderator")
  ADMIN     @map("admin")

  @@map("system_role")
}

enum UserStatus {
  PENDING @map("pending")
  ACTIVE  @map("active")
  BLOCKED @map("blocked")
  DELETED @map("deleted")

  @@map("user_status")
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PUBLISHED
  DEAD
}

model User {
  id              String      @id @default(uuid()) @db.Uuid

  email           String      @unique @db.VarChar(255)

  passwordHash    String      @map("password_hash") @db.VarChar(255)

  systemRole      SystemRole  @default(USER) @map("system_role")
  status          UserStatus  @default(PENDING)

  emailVerifiedAt DateTime?   @map("email_verified_at") @db.Timestamptz
  lastLoginAt     DateTime?   @map("last_login_at") @db.Timestamptz
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz

  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  accountRestoreTokens AccountRestoreToken[]

  @@map("users")
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid

  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash   String    @unique @map("token_hash") @db.VarChar(255)
  deviceId    String?   @map("device_id") @db.Uuid

  deviceName  String?   @map("device_name") @db.VarChar(255)
  sessionName String?   @map("session_name") @db.VarChar(100)
  ipAddress   String?   @map("ip_address") @db.Inet
  userAgent   String?   @map("user_agent") @db.Text

  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz

  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@index([tokenHash])
  @@index([userId, deviceId])
  @@index([expiresAt])

  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid

  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash") @db.VarChar(255)

  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid

  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash") @db.VarChar(255)

  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@index([expiresAt])

  @@map("password_reset_tokens")
}

model AccountRestoreToken {
  id        String    @id @default(uuid()) @db.Uuid

  userId    String    @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@index([expiresAt])
  
  @@map("account_restore_tokens")
}

model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid

  topic        String @db.VarChar(255)
  eventType    String @map("event_type") @db.VarChar(150)
  eventVersion Int    @default(1) @map("event_version")

  aggregateType String @map("aggregate_type") @db.VarChar(100)
  aggregateId   String @map("aggregate_id") @db.VarChar(255)
  partitionKey  String @map("partition_key") @db.VarChar(255)

  payload Json

  status   OutboxEventStatus @default(PENDING)
  attempts Int               @default(0)

  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz(3)
  lockedBy    String?   @map("locked_by") @db.VarChar(100)

  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  lastError   String?   @map("last_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, availableAt], map: "outbox_events_status_available_at_idx")

  @@index([aggregateType, aggregateId], map: "outbox_events_aggregate_idx")

  @@index([lockedAt], map: "outbox_events_locked_at_idx")

  @@map("outbox_events")
}