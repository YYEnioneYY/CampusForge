generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Country {
  id        String @id @default(uuid()) @db.Uuid

  code2     String @unique @map("code_2") @db.Char(2)
  code3     String @unique @map("code_3") @db.Char(3)

  name      String @db.VarChar(150)

  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@index([isActive])

  @@map("countries")
}

model Skill {
  id             String   @id @default(uuid()) @db.Uuid

  name           String   @db.VarChar(80)
  normalizedName String   @unique @map("normalized_name") @db.VarChar(80)
  slug           String   @unique @db.VarChar(100)

  isActive       Boolean  @default(true) @map("is_active")

  aliases        SkillAlias[]

  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([isActive])
  @@map("skills")
}

model SkillAlias {
  id              String   @id @default(uuid()) @db.Uuid

  skillId         String   @map("skill_id") @db.Uuid
  skill           Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  alias           String   @db.VarChar(80)
  normalizedAlias String   @unique @map("normalized_alias") @db.VarChar(80)

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([skillId])
  @@map("skill_aliases")
}